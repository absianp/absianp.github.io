---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import AdSense from '../../components/AdSense.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="전체 아티클 목록 | TechFlow"
  description="AI 활용법, 개발 생산성, 자동화 부업 파이프라인 등 TechFlow의 모든 아티클 목록입니다."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-10">
      <div class="text-xs font-semibold text-blue-600 uppercase tracking-wide mb-1">Archive</div>
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">전체 아티클 ({sortedPosts.length})</h1>
      <p class="text-slate-600 text-sm mt-2">최신 순으로 정렬된 모든 테크 & 실전 가이드입니다.</p>
    </div>

    <AdSense slotId="1234567890" type="top-banner" />

    {sortedPosts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 my-8">
        {sortedPosts.map(post => (
          <Card
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.slug}
            category={post.data.category}
            readingTime={post.data.readingTime}
            heroImage={post.data.heroImage}
            tags={post.data.tags}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 bg-white rounded-2xl border border-slate-200">
        <p class="text-slate-500 text-sm">아직 작성된 글이 없습니다.</p>
      </div>
    )}

    <AdSense slotId="4567890123" type="bottom-banner" />
  </div>
</BaseLayout>
