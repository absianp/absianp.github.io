---
import { getCollection } from 'astro:content';
import BlogArchive from '../../components/BlogArchive.astro';
import { sortPosts, POSTS_PER_PAGE } from '../../utils/archive';
const posts = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
---
<BlogArchive posts={posts.slice(0, POSTS_PER_PAGE)} totalPosts={posts.length} currentPage={1} totalPages={Math.max(1, Math.ceil(posts.length / POSTS_PER_PAGE))} />
