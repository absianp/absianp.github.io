---
import { getCollection } from 'astro:content';
import BlogArchive from '../../../components/BlogArchive.astro';
import { sortPosts, POSTS_PER_PAGE } from '../../../utils/archive';
export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
  const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
    const page = i + 2;
    return { params: { page: String(page) }, props: {
      posts: posts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE),
      totalPosts: posts.length, currentPage: page, totalPages,
    } };
  });
}
---
<BlogArchive {...Astro.props} />
