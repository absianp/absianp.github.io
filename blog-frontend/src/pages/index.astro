---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import AdSense from '../components/AdSense.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = sortedPosts.slice(0, 6);

const categories = [
  { name: '전체 글', href: `${base}/blog/` },
  { name: 'AI & 생산성', href: `${base}/categories/ai-productivity/` },
  { name: '개발 & 테크', href: `${base}/categories/tech-dev/` },
  { name: '스마트 부업', href: `${base}/categories/side-income/` },
];
---

<BaseLayout
  title="TechFlow - AI & 테크 인사이트 및 스마트 부업 가이드"
  description="AI 생산성 도구, 실전 개발 팁, 자동화 부업 파이프라인 및 최신 테크 트렌드 전문 블로그"
>
  <section class="bg-gradient-to-b from-blue-50/70 via-slate-50 to-slate-50 border-b border-slate-200/60 py-16 sm:py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-100/80 text-blue-700 text-xs font-semibold mb-6">
        <span>✨ 2026 최신 AI & 스마트 자동화 테크 매거진</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight leading-tight max-w-3xl mx-auto mb-6">
        일상을 혁신하는 <span class="text-blue-600">AI 도구</span>와 <br class="hidden sm:inline" />실전 자동화 테크 가이드
      </h1>
      <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto leading-relaxed mb-8">
        검증된 개발 팁부터 무자본 디지털 노마드 부업 전략까지, 생산성을 극대화하는 실질적인 인사이트를 제공합니다.
      </p>
      
      <div class="flex flex-wrap items-center justify-center gap-2">
        {categories.map(cat => (
          <a
            href={cat.href}
            class="px-4 py-2 bg-white hover:bg-blue-600 hover:text-white text-slate-700 font-medium text-xs rounded-xl border border-slate-200 shadow-sm transition-all"
          >
            {cat.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <AdSense slotId="1234567890" type="top-banner" />
  </div>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-bold text-slate-900 tracking-tight">최신 아티클</h2>
        <p class="text-sm text-slate-500 mt-1">에이전트가 엄선한 고품질 테크 & 생산성 가이드</p>
      </div>
      <a href={`${base}/blog/`} class="text-sm font-semibold text-blue-600 hover:text-blue-700">
        전체보기 →
      </a>
    </div>

    {recentPosts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {recentPosts.map(post => (
          <Card
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.slug}
            category={post.data.category}
            readingTime={post.data.readingTime}
            heroImage={post.data.heroImage}
            tags={post.data.tags}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 bg-white rounded-2xl border border-dashed border-slate-200">
        <p class="text-slate-500 text-sm">아직 등록된 포스트가 없습니다. 에이전트를 실행하여 첫 글을 발행해보세요!</p>
      </div>
    )}

    <div class="mt-12">
      <AdSense slotId="3456789012" type="multiplex" />
    </div>
  </section>
</BaseLayout>
