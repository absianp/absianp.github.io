---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const routes = [
  { id: 'files', goal: '다운로드 폴더를 정리하고 싶어요',
    description: '파일 이름이 겹치거나 내용이 같은 경우부터 살펴보세요. 미리보기와 실제 반영의 차이, 재현한 결과와 남은 한계를 함께 읽을 수 있습니다.',
    slug: '2026-09-17-post-1a1a2c', preparation: '준비: Python과 연습용 파일 복사본', next: '먼저 미리보기와 충돌 처리 기준을 확인하세요.' },
  { id: 'excel', goal: '여러 엑셀 파일을 한곳에 모으고 싶어요',
    description: '엑셀 취합 글에서 입력 폴더, 템플릿, 출력 파일을 어떻게 구분하는지 찾아보세요. 예제의 실행 검증 범위도 함께 확인할 수 있습니다.',
    slug: '2026-09-13-openpyxl-1f5f78', preparation: '준비: 원본과 분리한 연습용 엑셀 파일', next: '서식 처리 범위와 예제의 검증 안내부터 읽어보세요.' },
  { id: 'rss', goal: 'RSS 링크를 정기적으로 받아보고 싶어요',
    description: 'GitHub Actions와 텔레그램을 사용하는 예제로 이동합니다. 필요한 계정 설정과 예약 지연, 중복 발송에 대한 설명을 확인하세요.',
    slug: '2026-09-12-0-github-actions', preparation: '준비: 읽을 RSS 피드와 본인 테스트 대화', next: '예약을 등록하기 전에 로컬 미리보기부터 확인하세요.' },
];
const guides = routes.map(route => {
  const post = posts.find(post => post.slug === route.slug);
  if (!post) throw new Error(`Start guide target is not published: ${route.slug}`);
  return { ...route, post };
});
---

<BaseLayout title="파이썬 업무 자동화 시작하기: 파일 정리·엑셀 취합·RSS 알림" description="자동화할 작업부터 고르세요. 다운로드 폴더 정리, 엑셀 취합, RSS 알림 예제를 준비물과 읽는 순서에 따라 안내합니다.">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 break-keep">
    <nav aria-label="현재 위치" class="text-sm text-slate-500 mb-6"><a href="/" class="hover:text-blue-600">홈</a> / 시작 안내</nav>
    <header class="max-w-3xl mb-10">
      <p class="text-sm font-semibold text-blue-600 mb-3">작업별 시작 안내</p>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 leading-tight">어떤 반복 작업을 줄이고 싶나요?</h1>
      <p class="mt-5 text-slate-600 leading-relaxed">도구 이름보다 지금 필요한 작업을 먼저 골라보세요. 예제마다 준비물과 실행 범위가 다릅니다. 입력과 결과를 확인할 수 있는 작은 복사본으로 시작해 보세요.</p>
    </header>
    <nav aria-label="자동화할 작업 선택" class="flex flex-wrap gap-3 mb-8">
      {guides.map(guide => <a href={`#${guide.id}`} class="rounded-full border border-blue-200 bg-blue-50 px-4 py-2 text-sm text-blue-800">{guide.goal}</a>)}
    </nav>
    <div class="space-y-6">
      {guides.map((guide, index) => <section id={guide.id} class="scroll-mt-24 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
        <p class="text-xs font-semibold text-blue-600 mb-2">선택 {index + 1}</p>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900">{guide.goal}</h2>
        <p class="mt-3 text-slate-600 leading-relaxed">{guide.description}</p>
        <p class="mt-4 text-sm font-medium text-slate-700">{guide.preparation}</p>
        <p class="mt-2 text-sm text-slate-600">{guide.next}</p>
        <a href={`/blog/${guide.post.slug}/`} class="mt-5 inline-block font-semibold text-blue-700 underline underline-offset-4">{guide.post.data.title} →</a>
      </section>)}
    </div>
    <aside class="mt-10 rounded-2xl bg-slate-100 p-6">
      <h2 class="text-lg font-bold text-slate-900">다른 작업을 찾고 있나요?</h2>
      <p class="mt-3 text-slate-600"><a class="text-blue-700 underline" href="/categories/">주제별 글 목록</a>에서 분야를 고르거나 <a class="text-blue-700 underline" href="/search/">사이트 검색</a>으로 도구 이름을 찾아보세요.</p>
      <p class="mt-3 text-slate-600">새 글은 <a class="text-blue-700 underline" href="/rss.xml">RSS 피드</a>로 구독할 수 있습니다.</p>
    </aside>
  </div>
</BaseLayout>
