---
import { getCategorySlug } from '../utils/slug';

export interface Props {
  title: string;
  description?: string;
  slug: string;
  category: string;
  pubDate: Date;
  readingTime?: string;
  heroImage?: string;
}

const {
  title,
  description = '',
  slug,
  category,
  pubDate,
  readingTime = '5 min',
  heroImage,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categorySlug = getCategorySlug(category);

const formattedDate = new Intl.DateTimeFormat('ko-KR', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(pubDate);

const thumbnailSrc = heroImage && heroImage !== '/images/default-hero.svg'
  ? heroImage
  : `${base}/og/${slug}.svg`;
---

<article class="group bg-white rounded-2xl border border-slate-200/80 overflow-hidden shadow-xs hover:shadow-lg hover:border-blue-400 transition-all duration-300 flex flex-col">
  <!-- Thumbnail Link & Image -->
  <a href={`${base}/blog/${slug}/`} class="relative block overflow-hidden aspect-[1200/630] bg-slate-950">
    <img
      src={thumbnailSrc}
      alt={title}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      loading="lazy"
    />
    <!-- Floating category pill overlay -->
    <span class="absolute top-2.5 left-2.5 px-2 py-0.5 text-[11px] font-semibold bg-slate-900/85 backdrop-blur-md text-blue-300 rounded-full border border-white/10 shadow-xs">
      {category}
    </span>
  </a>

  <!-- Compact Content Info: 글 제목 대신 내용 첫부분/요약문 노출 -->
  <div class="p-3.5 flex-1 flex flex-col justify-between">
    <a href={`${base}/blog/${slug}/`} class="block group/text my-1">
      <p class="text-xs sm:text-sm text-slate-600 group-hover/text:text-blue-600 transition-colors line-clamp-3 leading-relaxed">
        {description || title}
      </p>
    </a>

    <div class="flex items-center justify-between text-[11px] text-slate-400 pt-2.5 border-t border-slate-100">
      <span>{formattedDate}</span>
      <span class="flex items-center gap-1 text-blue-600 font-medium group-hover:translate-x-0.5 transition-transform">
        읽어보기 &rarr;
      </span>
    </div>
  </div>
</article>
