---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = [
  { label: '홈', href: `${base}/` },
  { label: '전체 글', href: `${base}/blog/` },
  { label: 'AI & 생산성', href: `${base}/categories/ai-productivity/` },
  { label: '개발 & 테크', href: `${base}/categories/tech-dev/` },
  { label: '스마트 부업', href: `${base}/categories/side-income/` },
  { label: '소개', href: `${base}/about/` },
];
---

<header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200/80 transition-all duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Logo -->
    <a href={`${base}/`} class="flex items-center gap-2.5 group flex-shrink-0">
      <img
        src={`${base}/favicon.svg`}
        alt="앱시안(absian) 로고"
        class="w-9 h-9 rounded-xl shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform"
      />
      <div class="flex flex-col">
        <span class="font-bold text-slate-900 text-lg tracking-tight group-hover:text-blue-600 transition-colors">
          앱시안(absian)
        </span>
        <span class="text-[10px] text-slate-500 -mt-1 font-medium tracking-wide uppercase">AI & Tech Insights</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-1 text-sm font-medium text-slate-600">
      {navItems.map(item => (
        <a
          href={item.href}
          class="px-3 py-1.5 rounded-lg hover:text-blue-600 hover:bg-slate-100/80 transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Right Action (Search / RSS / Contact) -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Search Button (Quick link to Search Page) -->
      <a
        href={`${base}/search/`}
        class="flex items-center gap-2 px-3 py-1.5 text-xs font-medium text-slate-600 bg-slate-100/80 hover:bg-blue-50 hover:text-blue-600 border border-slate-200/80 rounded-xl transition-all shadow-sm group"
        title="아티클 검색 (Cmd + K)"
      >
        <svg class="w-4 h-4 text-slate-400 group-hover:text-blue-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline">검색</span>
        <kbd class="hidden md:inline-block px-1.5 py-0.5 text-[10px] font-mono font-semibold text-slate-400 bg-white border border-slate-200 rounded shadow-2xs">
          ⌘K
        </kbd>
      </a>

      <!-- RSS Feed -->
      <a
        href={`${base}/rss.xml`}
        class="p-2 text-slate-500 hover:text-amber-500 hover:bg-slate-100 rounded-lg transition-colors"
        title="RSS 피드 구독"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93v-2.83Z" />
        </svg>
      </a>

      <!-- Contact Button -->
      <a
        href={`${base}/contact/`}
        class="hidden sm:inline-flex items-center justify-center px-4 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm transition-all"
      >
        문의하기
      </a>
    </div>
  </div>
</header>

<script is:inline define:vars={{ base }}>
  // Global Shortcut Cmd+K / Ctrl+K to navigate to /search/
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (!window.location.pathname.includes('/search')) {
        window.location.href = `${base}/search/`;
      } else {
        const input = document.getElementById('searchInput');
        if (input) input.focus();
      }
    }
  });
</script>
