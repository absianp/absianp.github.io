[Unit]
Description=Auto Blog System - Weekly Monitoring & AdSense Earnings Reporter
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/auto_blog_system/automation-pipeline
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/pi/auto_blog_system/automation-pipeline/config/.env
ExecStart=/home/pi/auto_blog_system/automation-pipeline/venv/bin/python3 main_pipeline.py --mode report
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
