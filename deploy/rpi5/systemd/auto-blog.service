[Unit]
Description=Auto Blog System - Daily Content Harvester & Publisher Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ian/auto_blog_system/automation-pipeline
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/ian/auto_blog_system/automation-pipeline/config/.env
ExecStart=/home/ian/auto_blog_system/automation-pipeline/venv/bin/python3 main_pipeline.py --mode auto --approve
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
